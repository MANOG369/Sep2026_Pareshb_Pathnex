global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    maxconn 2048

defaults
    mode http
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    option httpchk GET /
    server web1 10.0.1.10:80 check
    server web2 10.0.1.11:80 check

listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 10s
